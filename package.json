{
  "name": "locatorforge",
  "private": true,
  "version": "0.8.0",
  "description": "LocatorForge — fast Chrome DevTools extension. Playwright, Selenium, Cypress, WebdriverIO, Robot Framework locators. No ads, no tracking, no BS.",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "release": "npm run build && npm run package",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^7.0.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.10"
  }
}

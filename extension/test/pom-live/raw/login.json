  "code": "import { type Locator, type Page } from '@playwright/test';\n\nexport class LoginPage {\n  readonly page: Page;\n  readonly textboxUsername: Locator;\n  readonly textboxPassword: Locator;\n  readonly buttonLogin: Locator;\n  readonly forgotYourPassword: Locator;\n  readonly imgCompanyBranding: Locator;\n  readonly link: Locator;\n\n  constructor(page: Page) {\n    this.page = page;\n    this.textboxUsername = page.getByRole(\"textbox\", { name: \"Username\" });\n    this.textboxPassword = page.getByRole(\"textbox\", { name: \"Password\" });\n    this.buttonLogin = page.getByRole(\"button\", { name: \"Login\" });\n    this.forgotYourPassword = page.getByText(\"Forgot your password?\");\n    this.imgCompanyBranding = page.getByRole(\"img\", { name: \"company-branding\" });\n    this.link = page.getByRole(\"link\");\n  }\n\n  async goto() {\n    await this.page.goto(\"https://opensource-demo.orangehrmlive.com/web/index.php/auth/login\");\n  }\n}\n",

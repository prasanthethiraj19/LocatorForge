{
  "manifest_version": 3,
  "name": "LocatorForge",
  "short_name": "LocatorForge",
  "version": "0.8.0",
  "description": "Fast Playwright, Selenium, Cypress, WebdriverIO and Robot Framework locators — straight from Edge DevTools. Recorder, freeze, test data, exports. No ads, no tracking, no BS.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "devtools_page": "devtools.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"],
  "web_accessible_resources": [
    {
      "resources": ["content.css", "freeze.css", "recorder.css", "freeze.js", "recorder.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "action": {
    "default_title": "Open LocatorForge (Side Panel or DevTools)"
  },
  "commands": {
    "snaplocator-toggle-freeze": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Freeze / unfreeze page DOM (keeps hover menus open)"
    },
    "snaplocator-toggle-record": {
      "suggested_key": {
        "default": "Ctrl+Shift+R",
        "mac": "Command+Shift+R"
      },
      "description": "Start / stop LocatorForge recorder"
    },
    "snaplocator-open-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open LocatorForge side panel"
    }
  }
}
